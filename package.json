{
  "name": "unifind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=src/lib --coverage.thresholds.lines=70 --coverage.thresholds.functions=65 --coverage.thresholds.statements=70 --coverage.thresholds.branches=60",
    "test:integration": "INTEGRATION_BASE_URL=http://localhost:3000 vitest run tests/integration",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts && npm run db:contract",
    "db:contract": "tsx scripts/check-db-contract.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "supabase": "^2.115.1-beta.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
