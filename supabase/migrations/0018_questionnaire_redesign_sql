-- Supports the redesigned questionnaire flow (chat spec: exact 11-step
-- order — residence, target countries, education stage, start year,
-- field of study, language of instruction, language proficiency, exam
-- results, subject strengths, budget incl. living costs, extra
-- requirements).
--
-- Most of the 11 steps already had a home in `user_profiles` /
-- `user_nmt_scores` / `user_subject_strengths` / `career_priorities` —
-- this migration only adds what's genuinely new:
--   - where the user currently lives (was missing entirely; NMT/exam
--     relevance is driven off this, not off target country)
--   - when they want to start
--   - a living-cost budget tier, alongside the existing tuition budget
--   - per-language self-rated proficiency (separate from the CEFR/test
--     mechanism on user_profiles.english_level, which is a finer-grained
--     measurement for English specifically)

alter table user_profiles
  add column residence_country_code text references countries (code),
  add column residence_city text,
  -- Free text rather than an int/enum: valid values are specific years
  -- ('2026', '2027', '2028') plus 'later' and 'not_sure', which aren't
  -- years at all.
  add column start_year text,
  add column living_cost_mode budget_mode not null default 'unknown',
  add column living_cost_min numeric(12, 2) check (living_cost_min is null or living_cost_min >= 0),
  add column living_cost_max numeric(12, 2) check (living_cost_max is null or living_cost_max >= 0);

-- The onboarding wizard's "what stage of education are you at?" question
-- (spec item 3) is richer than `current_education_level` (which is a
-- matching-engine input compared against programme requirements) and
-- richer than `has_graduated` (a plain boolean) — it distinguishes school
-- grade. Kept as its own column rather than replacing either: the
-- onboarding action derives `current_education_level` and `has_graduated`
-- from it, so the matching engine and the existing profile form don't
-- need to know this question exists.
create type education_stage as enum (
  'grade_9', 'grade_10', 'grade_11', 'graduated', 'college', 'other'
);

alter table user_profiles
  add column education_stage education_stage;

comment on column user_profiles.education_stage is 'What stage of school/education the user is currently at (spec item 3). current_education_level and has_graduated are derived from this by the onboarding action, not asked separately.';

comment on column user_profiles.residence_country_code is 'Country the user currently lives in — drives which national exam question (NMT, Matura, ...) is relevant, spec item 8.';
comment on column user_profiles.residence_city is 'City the user currently lives in (free text — no full city reference table yet).';
comment on column user_profiles.start_year is 'When the user wants to start studying: a specific year, ''later'', or ''not_sure''.';
comment on column user_profiles.living_cost_mode is 'Monthly living-cost budget tier, same scale as budget_mode for tuition.';
comment on column user_profiles.living_cost_min is 'Monthly living-cost lower bound, only set when living_cost_mode = ''exact''.';
comment on column user_profiles.living_cost_max is 'Monthly living-cost upper bound, only set when living_cost_mode = ''exact''.';

-- National exam → residence country mapping (spec item 8: "не стоит
-- предполагать, что в каждой стране есть единый экзамен... лучше в базе
-- хранить admission_exam/qualification для конкретной страны и
-- показывать вопрос только там, где это реально релевантно"). Nullable:
-- only 'national'-category qualifications get one, and only where we
-- actually know it applies — NMT/UA today. Absence of a match means the
-- onboarding wizard skips the national-exam question entirely rather
-- than guessing.
alter table qualifications
  add column country_code text references countries (code);

comment on column qualifications.country_code is 'For category = ''national'' qualifications: which country''s school-leaving/admission exam this is (e.g. NMT → UA). Null for exams that aren''t tied to one country (SAT, IB, ...) or not yet mapped — the onboarding wizard only asks about a national exam when a match exists for the user''s residence country.';

update qualifications set country_code = 'UA' where code = 'nmt';

-- Computer Science wasn't in the original NMT subject list (it isn't a
-- standalone NMT subject in Ukraine) but the subject-strength
-- self-rating (spec item 9) needs it as a category, and
-- `user_subject_strengths` already keys off this catalog.
insert into nmt_subjects (code, name) values
  ('computer_science', 'Computer Science / Informatics')
on conflict (code) do nothing;

create type language_proficiency_level as enum ('good', 'medium', 'poor', 'not_sure');

create table user_language_proficiency (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users (id) on delete cascade,
  language_code text not null references languages (code) on delete cascade,
  level language_proficiency_level not null,
  created_at timestamptz not null default now(),
  unique (user_id, language_code)
);

comment on table user_language_proficiency is 'Self-rated proficiency per language of instruction the user selected (spec item 7) — separate from the CEFR/test-score mechanism, which is specific to English.';

create index user_language_proficiency_user_id_idx on user_language_proficiency (user_id);

alter table user_language_proficiency enable row level security;

create policy "Users manage their own language proficiency"
  on user_language_proficiency
  for all
  using (auth.uid() = user_id)
  with check (auth.uid() = user_id);